{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "build:static": "vp build static",
        "dev:cf": "vp build static && wrangler d1 migrations apply DB --local && wrangler dev",
        "deploy:cf": "wrangler d1 migrations apply DB --remote && wrangler deploy",
        "dev": "vp dev",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "types:check": "tsc --noEmit"
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "qrcode": "^1.5.4",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261118.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@rolldown/plugin-babel": "^0.2.3",
        "@types/node": "^22.13.5",
        "@types/qrcode": "^1.5.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "vite-plus": "1.4.0",
        "wrangler": "^4.164.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    }
}
